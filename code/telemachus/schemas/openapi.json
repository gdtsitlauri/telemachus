{
  "components": {
    "schemas": {
      "EpisodeRequest": {
        "properties": {
          "max_cost": {
            "default": 120.0,
            "exclusiveMinimum": 0.0,
            "maximum": 200.0,
            "title": "Max Cost",
            "type": "number"
          },
          "max_steps": {
            "default": 160,
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Max Steps",
            "type": "integer"
          },
          "method": {
            "default": "telemachus",
            "enum": [
              "legacy_v4",
              "nominal",
              "confidence_gate",
              "budget_voi",
              "telemachus",
              "no_learning",
              "no_reserve",
              "no_source",
              "no_model_update",
              "fixed_compute"
            ],
            "title": "Method",
            "type": "string"
          },
          "scenario": {
            "default": "nominal",
            "enum": [
              "nominal",
              "visual",
              "localization",
              "dynamics",
              "radio",
              "compound"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "seed": {
            "default": 100,
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "title": "EpisodeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MissionRequest": {
        "properties": {
          "image_base64": {
            "maxLength": 350000,
            "minLength": 8,
            "title": "Image Base64",
            "type": "string"
          },
          "instruction": {
            "default": "Identify the red landing pad",
            "maxLength": 300,
            "minLength": 3,
            "title": "Instruction",
            "type": "string"
          },
          "left_goal": {
            "default": [
              8.25,
              9.25
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Left Goal",
            "type": "array"
          },
          "right_goal": {
            "default": [
              9.25,
              9.25
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Right Goal",
            "type": "array"
          }
        },
        "required": [
          "image_base64"
        ],
        "title": "MissionRequest",
        "type": "object"
      },
      "PerceptionRequest": {
        "properties": {
          "tiles": {
            "items": {
              "items": {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            },
            "title": "Tiles",
            "type": "array"
          }
        },
        "required": [
          "tiles"
        ],
        "title": "PerceptionRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TELEMACHUS v5 research simulator",
    "version": "5.0.0"
  },
